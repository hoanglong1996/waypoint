FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY packages/waypoint_etl /tmp/waypoint_etl
RUN pip install --no-cache-dir "/tmp/waypoint_etl[redis]" && rm -rf /tmp/waypoint_etl

COPY packages/waypoint_etl/examples/sample_pipeline.py .

CMD ["python", "sample_pipeline.py"]
