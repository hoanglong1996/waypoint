# Copy to .env.qa / .env.prod and run: python -m app.main -c qa
# Real environment variables override values from the file.
REDIS_URL=redis://localhost:6379/0
ENVIRONMENTS=prod,qa
STALE_HOURS=26
REFRESH_SECONDS=60
RETRY_SECONDS=30
CACHE_SECONDS=10
PORT=8080
# A run whose heartbeat is older than this many seconds, with unfinished work, is shown as Died.
# HEARTBEAT_DEAD_SECONDS=90
# A run is "Slower than usual" above this multiple of the median duration of recent completed runs,
# once at least DURATION_MIN_RUNS completed runs exist; the median uses the newest DURATION_WINDOW_RUNS.
# SLOW_RUN_MULTIPLE=2.0
# DURATION_WINDOW_RUNS=30
# DURATION_MIN_RUNS=5
